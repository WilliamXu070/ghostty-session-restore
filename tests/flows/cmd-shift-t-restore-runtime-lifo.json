{
  "name": "cmd-shift-t-restore-runtime-lifo",
  "setup": {
    "type": "fresh-ghostty",
    "wait": 2,
    "env": {
      "NEWMUX_GHOSTTY_UI_STATUS": "1"
    }
  },
  "steps": [
    {
      "do": "snapshot",
      "as": "start"
    },
    {
      "do": "cmd_t",
      "from": "start"
    },
    {
      "do": "snapshot",
      "as": "dirty_tab_clean_baseline"
    },
    {
      "do": "send_keys",
      "from": "dirty_tab_clean_baseline",
      "target": "latest_window",
      "keys": [
        "printf 'newmux-restore-flow'",
        "Enter"
      ]
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "snapshot",
      "as": "dirty_tab"
    },
    {
      "do": "cmd_w",
      "from": "dirty_tab",
      "target": "latest_window"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "snapshot",
      "as": "after_dirty_delete"
    },
    {
      "do": "ui_snapshot",
      "as": "ui_after_dirty_delete"
    },
    {
      "do": "physical_shortcut",
      "key": "t",
      "modifiers": [
        "command down",
        "shift down"
      ]
    },
    {
      "do": "wait",
      "seconds": 4
    },
    {
      "do": "snapshot",
      "as": "after_restore"
    },
    {
      "do": "ui_snapshot",
      "as": "ui_after_restore"
    }
  ],
  "expect": [
    {
      "state": "dirty_tab",
      "workspaces": 1,
      "windows": 2,
      "panes": 2,
      "dirty_windows": 1,
      "dirty_panes": 1,
      "lifo": 0
    },
    {
      "state": "after_dirty_delete",
      "workspaces": 1,
      "windows": 1,
      "panes": 1,
      "lifo": 1
    },
    {
      "ui_state": "ui_after_dirty_delete",
      "native_tabs": 1,
      "rail_tabs": 1
    },
    {
      "state": "after_restore",
      "workspaces": 1,
      "windows": 2,
      "panes": 2,
      "lifo": 0
    },
    {
      "ui_state": "ui_after_restore",
      "native_tabs": 2,
      "rail_tabs": 2
    }
  ]
}
