{
  "name": "cmd-t-multiple-cmd-d",
  "setup": {
    "type": "fresh-ghostty",
    "wait": 2
  },
  "steps": [
    {
      "do": "snapshot",
      "as": "start"
    },
    {
      "do": "cmd_t",
      "from": "start"
    },
    {
      "do": "snapshot",
      "as": "after_t1"
    },
    {
      "do": "cmd_t",
      "from": "after_t1"
    },
    {
      "do": "snapshot",
      "as": "after_t2"
    },
    {
      "do": "cmd_t",
      "from": "after_t2"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "snapshot",
      "as": "after_t3"
    },
    {
      "do": "cmd_d",
      "from": "after_t3"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "snapshot",
      "as": "after_d"
    }
  ],
  "expect": [
    {
      "state": "start",
      "workspaces": 1,
      "windows": 1,
      "panes": 1
    },
    {
      "state": "after_t1",
      "workspaces": 1,
      "windows": 2,
      "panes": 2
    },
    {
      "state": "after_t2",
      "workspaces": 1,
      "windows": 3,
      "panes": 3
    },
    {
      "state": "after_t3",
      "workspaces": 1,
      "windows": 4,
      "panes": 4
    },
    {
      "state": "after_d",
      "workspaces": 1,
      "windows": 4,
      "panes": 5
    },
    {
      "delta": {
        "from": "after_t3",
        "to": "after_d"
      },
      "workspaces": 0,
      "windows": 0,
      "panes": 1
    }
  ]
}
