{
  "name": "cmd-w-ui-tab-sync",
  "setup": {
    "type": "fresh-ghostty",
    "wait": 2,
    "env": {
      "NEWMUX_GHOSTTY_UI_STATUS": "1"
    }
  },
  "steps": [
    {
      "do": "snapshot",
      "as": "start"
    },
    {
      "do": "ui_snapshot",
      "as": "ui_start"
    },
    {
      "do": "physical_shortcut",
      "key": "t",
      "modifiers": [
        "command down"
      ]
    },
    {
      "do": "wait",
      "seconds": 4
    },
    {
      "do": "snapshot",
      "as": "after_cmd_t"
    },
    {
      "do": "ui_snapshot",
      "as": "ui_after_cmd_t"
    },
    {
      "do": "physical_shortcut",
      "key": "w",
      "modifiers": [
        "command down"
      ]
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "snapshot",
      "as": "after_cmd_w"
    },
    {
      "do": "ui_snapshot",
      "as": "ui_after_cmd_w"
    }
  ],
  "expect": [
    {
      "state": "start",
      "workspaces": 1,
      "windows": 1,
      "panes": 1
    },
    {
      "ui_state": "ui_start",
      "ui_enabled": false,
      "status_enabled": true,
      "native_tabs": 1,
      "rail_tabs": 1
    },
    {
      "state": "after_cmd_t",
      "workspaces": 1,
      "windows": 2,
      "panes": 2
    },
    {
      "ui_state": "ui_after_cmd_t",
      "native_tabs": 2,
      "rail_tabs": 2
    },
    {
      "state": "after_cmd_w",
      "workspaces": 1,
      "windows": 1,
      "panes": 1,
      "lifo": 0
    },
    {
      "ui_state": "ui_after_cmd_w",
      "native_tabs": 1,
      "rail_tabs": 1
    }
  ]
}
