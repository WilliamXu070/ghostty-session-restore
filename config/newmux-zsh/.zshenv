# Newmux dev shells use this ZDOTDIR so pane resizing stays visually stable.
# Keep this file tiny: it is sourced by every zsh process, interactive or not.

export NEWMUX_ZSH_DISABLE_RPROMPT=1
export POWERLEVEL9K_DISABLE_RPROMPT=true
export POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=()
export SPACESHIP_RPROMPT_ORDER=()
