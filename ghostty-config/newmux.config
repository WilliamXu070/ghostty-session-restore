# Ghostty test profile for newmux.
#
# Add this file through Ghostty's `config-file` option, or run:
#   scripts/open-newmux-ghostty.sh
#
# Ghostty docs: `command` runs a command for new terminal surfaces, and
# `keybind = trigger=action` can send text/control bytes to the child process.

title = Newmux Dev
confirm-close-surface = false
window-save-state = never
command = direct:/Users/williamxu/Desktop/Projects/newmux/scripts/start-newmux-fresh.sh
shell-integration = none

# Private tmux user-key sequences for browser-style Newmux shortcuts.
# Cmd+T now creates a fresh Newmux window and attaches a new Ghostty tab.
# Cmd+Shift+T and Cmd+W remain listener-only while recovery is rebuilt.
keybind = cmd+shift+t=unbind
keybind = cmd+shift+t=text:\x1b[5;7788~

keybind = cmd+t=unbind
keybind = cmd+t=text:\x1b[5;7789~
keybind = chain=new_tab

keybind = cmd+w=unbind
keybind = cmd+w=text:\x1b[5;7790~
keybind = chain=close_tab

# Browser-adjacent pane commands. These use Newmux/tmux panes, not Ghostty's
# native split surfaces, so pane history/layout participates in Newmux recovery.
keybind = cmd+d=unbind
keybind = cmd+d=text:\x02|
keybind = cmd+shift+d=unbind
keybind = cmd+shift+d=text:\x02V
keybind = cmd+alt+w=unbind
keybind = cmd+alt+w=text:\x02D
keybind = cmd+ctrl+w=unbind
keybind = cmd+ctrl+w=text:\x02D

# Test tmux copy mode without manually pressing the tmux prefix.
keybind = cmd+shift+h=text:\x02H

# Use Ghostty's native copy action so Cmd+C never injects bytes into the PTY.
keybind = cmd+c=copy_to_clipboard

# Make Shift+Enter behave like Option+Enter for terminal apps that use
# Meta+Enter as "insert newline" instead of "submit".
keybind = alt+enter=text:\x1b\r
keybind = shift+enter=text:\x1b\r
